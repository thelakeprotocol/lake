# The public sandbox Lake behind automatic HTTPS (Let's Encrypt), for a server where ports 80/443 are free
# (docker compose -f deploy/docker-compose.sandbox.yml --profile caddy up -d). One domain:
#   /            the live map and the node's API (register, cards, events, signals, state, relay)
#   /s/<agent>/  the specialists: guide, inspector, sparring, quests, ethics, auditor, payments, issuer
#   /t/<name>/   hosted houses (A2A at /t/<name>/a2a, control panel at /t/<name>/owner/)
{$LAKE_DOMAIN} {
	encode zstd gzip
	handle_path /s/* {
		reverse_proxy 127.0.0.1:4300
	}
	# The hosted houses' pods, at a public address (Caddy passes the host and https on).
	# The pod server closes idle connections after Node's default 5 s; Caddy keeps its own for less, so it never sends a
	# request down one the pod server is closing (the Lake's own servers keep theirs longer than Caddy's 2 minutes).
	handle /pods/* {
		reverse_proxy 127.0.0.1:4310 {
			transport http {
				keepalive 4s
			}
		}
	}
	# Where an MCP client learns how to sign in (RFC 9728, RFC 8414): the connector answers for /mcp.
	handle /.well-known/oauth-* {
		reverse_proxy 127.0.0.1:4800
	}
	handle /mcp* {
		reverse_proxy 127.0.0.1:4800 {
			flush_interval -1
		}
	}
	handle /t/* {
		reverse_proxy 127.0.0.1:4000
	}
	handle {
		reverse_proxy 127.0.0.1:7000
	}
}
