{
  "name": "site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm blueprints && vitepress dev",
    "build": "pnpm blueprints && vitepress build",
    "preview": "vitepress preview",
    "blueprints": "node -e \"const fs=require('fs');fs.mkdirSync('public/blueprints',{recursive:true});for(const f of fs.readdirSync('../spec/blueprints'))if(f.endsWith('.md')&&f!=='README.md')fs.copyFileSync('../spec/blueprints/'+f,'public/blueprints/'+f)\""
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "vitepress": "1.6.4",
    "vitepress-plugin-llms": "1.14.0",
    "vue": "^3.5.13"
  }
}
