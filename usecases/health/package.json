    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "shapes.ttl",
    "vocab.ttl"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@thelakeprotocol/core": "workspace:^",
    "n3": "1"
  },
  "devDependencies": {
    "@types/n3": "^1.26.4",
    "@zazuko/env": "^3.0.2",
    "rdf-validate-shacl": "0.6.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thelakeprotocol/lake.git",
    "directory": "usecases/health"
  },
  "homepage": "https://lake.doneinfifty.com",
  "bugs": "https://github.com/thelakeprotocol/lake/issues",
  "keywords": [
    "lake",
    "solid",
    "a2a",
    "mcp",
    "agents",
    "odrl",
    "verifiable-credentials",
    "ap2",
    "privacy"
  ],
  "publishConfig": {
