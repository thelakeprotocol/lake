{
  "name": "@thelakeprotocol/usecase-health",
  "version": "0.1.0",
  "description": "Health research on the Lake: the health@1 pack (vocabulary, shapes, FHIR R4 converter, synthetic patients, studies). Runs inside the house; raw records never leave the pod.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
