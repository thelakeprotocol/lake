@prefix lake: <https://lake.doneinfifty.com/model/v0#> .
@prefix m:    <https://lake.doneinfifty.com/usecases/mortgage/v1#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

# mortgage@1: what its claims must look like, on top of the core shapes (model/shapes.ttl).

m:AmountShape a sh:NodeShape ;
  sh:targetClass m:IncomeAnnual, m:MonthlyCommitments, m:Savings ;
  sh:property [ sh:path lake:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^\\d{1,9}$" ] .

m:CountShape a sh:NodeShape ;
  sh:targetClass m:MissedPayments ;
  sh:property [ sh:path lake:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^\\d{1,3}$" ] .

m:EmploymentShape a sh:NodeShape ;
  sh:targetClass m:Employment ;
  sh:property [ sh:path lake:code ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "employed" "self-employed" ) ] .

# An existing home loan, for those who have one.
m:HomeLoanLenderShape a sh:NodeShape ;
  sh:targetClass m:HomeLoanLender ;
  sh:property [ sh:path lake:code ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "harbour" "granite" "lyrebird" "magpie" ) ] .

m:LoanAmountShape a sh:NodeShape ;
  sh:targetClass m:HomeLoanBalance, m:HomeValue, m:OverpayYearly ;
  sh:property [ sh:path lake:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^\\d{1,9}$" ] .

m:LoanRateShape a sh:NodeShape ;
  sh:targetClass m:HomeLoanRate ;
  sh:property [ sh:path lake:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^\\d{1,2}\\.\\d{2}$" ] .

m:LoanCountShape a sh:NodeShape ;
  sh:targetClass m:HomeLoanYears, m:LoyaltyGap ;
  sh:property [ sh:path lake:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^\\d{1,3}$" ] .

m:LenderOverpayShape a sh:NodeShape ;
  sh:targetClass m:LenderOverpay ;
  sh:property [ sh:path lake:code ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^(harbour|granite|lyrebird|magpie):(under-1k|1k-3k|3k-6k|6k-plus)$" ] .
