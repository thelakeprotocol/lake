{
  "name": "lake",
  "private": true,
  "description": "The Lake: your data stays home. Agents knock. Only humans cut keys.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter=!site build",
    "test": "vitest run",
    "typecheck": "tsc -b packages/core usecases/health packages/specialists packages/house packages/visitor",
    "site:dev": "pnpm --filter site dev",
    "site:build": "pnpm --filter site build",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "examples": "node scripts/make-examples.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "^22.20.5",
    "@types/ws": "8",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "ws": "8"
  },
  "pnpm": {
    "packageExtensions": {
      "drand-client@1.2.5": {
        "dependencies": {
          "@noble/hashes": "1.8.0"
        }
      }
    }
  }
}
