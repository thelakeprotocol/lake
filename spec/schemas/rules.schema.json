{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lake.doneinfifty.com/schemas/v0/rules.json",
  "title": "rules.yaml: an owner's standing rules",
  "type": "object",
  "required": [
    "owner"
  ],
  "properties": {
    "owner": {
      "type": "string"
    },
    "device": {
      "type": "string"
    },
    "default": {
      "enum": [
        "join",
        "decline",
        "ask"
      ],
      "default": "ask"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "decision"
        ],
        "properties": {
          "match": {
            "type": "object",
            "properties": {
              "purpose": {
                "enum": [
                  "research",
                  "academic-research",
                  "commercial-research",
                  "care",
                  "contact",
                  "service",
                  "insurance",
                  "credit",
                  "marketing",
                  "advertising",
                  "personalised-advertising",
                  "direct-marketing",
                  "security",
                  "legal"
                ],
                "description": "Covers the narrower purposes inside it (marketing covers advertising)"
              },
              "requester": {
                "type": "string"
              },
              "sponsor_verified": {
                "type": "boolean"
              },
              "ethics_approved": {
                "type": "boolean"
              },
              "audit_certified": {
                "type": "boolean"
              },
              "reputation_at_least": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "price_below": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "Matches offers paying less than this many dollars: decline research under $5"
              },
              "asks_identifying": {
                "type": "boolean",
                "description": "Matches offers that ask for any field a loaded pack marks directly identifying (a name, a date of birth, an account number): decline them before any join rule bargains over them"
              }
            },
            "additionalProperties": false
          },
          "allow_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "deny_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "min_price_usd": {
            "type": "number",
            "minimum": 0
          },
          "retention": {
            "type": "string"
          },
          "grant_hours": {
            "type": "integer",
            "minimum": 1
          },
          "decision": {
            "enum": [
              "join",
              "decline",
              "ask"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "negotiation": {
      "type": "object",
      "properties": {
        "join_collectives": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "trust": {
      "type": "object",
      "description": "Whose signatures count. Anyone not listed counts as no one.",
      "properties": {
        "issuers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "auditors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ethics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "payments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "regulators": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "intents": {
      "type": "array",
      "description": "What the owner is looking for, standing (SPEC \u00a712). A term set to \"auto\" is worked out inside the house from the owner's own data.",
      "items": {
        "type": "object",
        "required": [
          "pack",
          "terms"
        ],
        "properties": {
          "pack": {
            "type": "string"
          },
          "terms": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number"
              ]
            }
          }
        },
        "additionalProperties": false
      }
    },
    "privacy": {
      "type": "object",
      "properties": {
        "show_packs": {
          "type": "boolean",
          "description": "false: the house's public card doesn't name the kinds of data it holds; agents searching by kind won't find it"
        }
      },
      "additionalProperties": false
    },
    "door": {
      "description": "An open door (SPEC \u00a79.0): the house's address serves a page saying how to reach the owner through an agent",
      "oneOf": [
        {
          "const": true
        },
        {
          "type": "object",
          "properties": {
            "about": {
              "type": "string",
              "maxLength": 200
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "availability": {
      "description": "When the owner is free to meet (SPEC \u00a79.0): their assistant offers these times, around their agenda",
      "type": "object",
      "required": [
        "tz",
        "free"
      ],
      "properties": {
        "tz": {
          "type": "string",
          "description": "IANA time zone, e.g. Australia/Sydney"
        },
        "free": {
          "type": "array",
          "minItems": 1,
          "maxItems": 14,
          "items": {
            "type": "string",
            "pattern": "^[a-z]{3}(-[a-z]{3})?(,[a-z]{3}(-[a-z]{3})?)* \\d{2}:\\d{2}-\\d{2}:\\d{2}$"
          }
        },
        "meetings": {
          "type": "integer",
          "minimum": 15,
          "maximum": 240
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
