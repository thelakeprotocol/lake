{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lake.doneinfifty.com/schemas/v0/offer.json",
  "title": "Lake offer (flat view; on the wire it is an ODRL Offer)",
  "type": "object",
  "required": [
    "id",
    "requester",
    "purpose",
    "fields",
    "retention",
    "priceUsd",
    "credentials"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "requester": {
      "type": "string",
      "description": "Proven owner domain of the visitor"
    },
    "purpose": {
      "type": "string",
      "enum": ["research", "academic-research", "commercial-research", "care", "contact", "service", "insurance", "credit", "marketing", "advertising", "personalised-advertising", "direct-marketing", "security", "legal"],
      "description": "One of the Lake's purposes (SPEC §4), never prose"
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,39}$"
      },
      "minItems": 1,
      "maxItems": 32
    },
    "retention": {
      "type": "string",
      "description": "\"none\" or an ISO 8601 duration",
      "pattern": "^(none|P(?=\\d|T\\d)(\\d+Y)?(\\d+M)?(\\d+W)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+S)?)?)$"
    },
    "priceUsd": {
      "type": "number",
      "minimum": 0
    },
    "credentials": {
      "type": "object",
      "required": [
        "ethicsApproved",
        "sponsorVerified",
        "auditCertified"
      ],
      "properties": {
        "ethicsApproved": {
          "type": "boolean"
        },
        "sponsorVerified": {
          "type": "boolean"
        },
        "auditCertified": {
          "type": "boolean"
        }
      }
    },
    "minTier": {
      "enum": [
        "self-reported",
        "device-signed",
        "issuer-signed"
      ]
    },
    "note": {
      "type": "string",
      "description": "UNTRUSTED free text. Never evaluated; shown to humans only as a quote."
    },
    "study": {
      "type": "string",
      "pattern": "^urn:lake:study:",
      "description": "Id of the declarative study this offer is for"
    }
  }
}
